  "faqs": [
    {
      "id": 1,
      "category": "general",
      "question": "What is Official WhatsApp Business API?",
      "answer": "Official WhatsApp Business API is Meta's enterprise cloud solution that allows businesses to message customers programmatically, maintain verified sender branding, deploy multi-agent team inboxes, and build conversational AI chatbots without risking account bans.",
      "sort_order": 1
    },
    {
      "id": 2,
      "category": "general",
      "question": "How does InboxWa connect to my WhatsApp number?",
      "answer": "InboxWa connects directly to Meta's Official Cloud API. You can register a new phone number or migrate your existing business number in a few simple verification steps.",
      "sort_order": 2
    },
    {
      "id": 3,
      "category": "pricing",
      "question": "Can I upgrade or cancel my plan anytime?",
      "answer": "Yes, you can upgrade, downgrade, or cancel your plan at any time directly from your dashboard. We offer a 14-day free trial on all plans.",
      "sort_order": 1
    },
    {
      "id": 4,
      "category": "pricing",
      "question": "Are WhatsApp conversation charges included?",
      "answer": "InboxWa subscription covers platform features, flow builders, team seats, and shared inbox. Meta API conversation markup charges (if applicable) are billed at transparent Meta rates.",
      "sort_order": 2
    }
  ],
