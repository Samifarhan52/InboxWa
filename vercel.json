{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "public",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/lead.php",
      "dest": "/api/lead.js"
    },
    {
      "src": "/api/lead",
      "dest": "/api/lead.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1/index.html"
    }
  ]
}
