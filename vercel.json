{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/app.css",
      "dest": "/app.css"
    },
    {
      "src": "/main.js",
      "dest": "/main.js"
    },
    {
      "src": "/forms.js",
      "dest": "/forms.js"
    },
    {
      "src": "/i18n.js",
      "dest": "/i18n.js"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/api/lead.php",
      "dest": "/api/lead.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "chmod +x node_modules/@libphp/almalinux-9-v85/native/php/php && LD_LIBRARY_PATH=node_modules/@libphp/almalinux-9-v85/native/lib: node_modules/@libphp/almalinux-9-v85/native/php/php -v > public/php_test.txt 2>&1"
}