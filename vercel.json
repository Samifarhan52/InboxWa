{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1",
      "includeFiles": [
        "index.php",
        "includes/**",
        "config/**",
        "business-leads/**",
        "industry/**",
        "Industries/**",
        "channel/**",
        "channels/**",
        "products/**",
        "product/**",
        "solutions/**",
        "company/**",
        "contact/**",
        "pricing/**",
        "privacy/**",
        "terms/**",
        "security/**",
        "facebook-ads/**",
        "partners/**",
        "resources/**",
        "Locations/**",
        "auth/**",
        "admin/**",
        "features/**",
        "about/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/app.css",
      "dest": "/app.css"
    },
    {
      "src": "/main.js",
      "dest": "/main.js"
    },
    {
      "src": "/forms.js",
      "dest": "/forms.js"
    },
    {
      "src": "/i18n.js",
      "dest": "/i18n.js"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/api/lead.php",
      "dest": "/api/lead.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
